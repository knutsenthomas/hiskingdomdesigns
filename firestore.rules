rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CMS configs: Publicly readable. Writes only go through /api/update-cms,
    // which checks for a logged-in admin and writes with the service account
    // (service accounts are not affected by these rules).
    // NB: Deploy this only after the service account has Firestore access,
    // otherwise CMS editing stops working.
    match /cms_configs/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Wishlists: Accessible for storing customer wishlist items
    match /wishlists/{document=**} {
      allow read, write: if true;
    }

    // Affiliate applications: contain personal data. Only accessed through /api/customer-data,
    // which checks the logged-in member/admin and uses the service account.
    match /affiliate_applications/{document=**} {
      allow read, write: if false;
    }

    // Order returns: contain personal data. Only accessed through /api/customer-data,
    // which checks the logged-in member/admin and uses the service account.
    match /order_returns/{document=**} {
      allow read, write: if false;
    }

    // Customer chat sessions: Scoped to specific session ID; prevent bulk dumping of all customer chats
    match /chat_sessions/{sessionId} {
      allow get, create, update: if true;
      allow list, delete: if false;

      match /messages/{messageId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }

    // Internal Slack thread mappings: Strictly serverless backend only, blocked from client SDK
    match /slack_chat_threads/{document=**} {
      allow read, write: if false;
    }

    // Checkout incident alerts: Write-only for logging frontend checkout errors, no public read or modification
    match /checkout_incidents/{incidentId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
