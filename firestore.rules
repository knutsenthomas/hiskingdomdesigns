rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CMS configs: Publicly readable for site layout, but strictly read-only from client
    match /cms_configs/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Wishlists: Accessible for storing customer wishlist items
    match /wishlists/{document=**} {
      allow read, write: if true;
    }

    // Affiliate applications: Accessible for submitting and admin review
    match /affiliate_applications/{document=**} {
      allow read, write: if true;
    }

    // Order returns: Accessible for customer returns and admin review
    match /order_returns/{document=**} {
      allow read, write: if true;
    }

    // Customer chat sessions: Scoped to specific session ID; prevent bulk dumping of all customer chats
    match /chat_sessions/{sessionId} {
      allow get, create, update: if true;
      allow list, delete: if false;

      match /messages/{messageId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }

    // Internal Slack thread mappings: Strictly serverless backend only, blocked from client SDK
    match /slack_chat_threads/{document=**} {
      allow read, write: if false;
    }

    // Checkout incident alerts: Write-only for logging frontend checkout errors, no public read or modification
    match /checkout_incidents/{incidentId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
